---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
}
// Brand name "Plux" (owner 2026-08-19, supersedes working title "Sidera") — UI-facing name
// only; the repo and every technical identifier stay "frame the world".
const { title = "Plux" } = Astro.props;

// Social / link previews. Wix's headless SEO layer injects og:title + twitter:card=
// summary_large_image but NOT an image or description, so an unfixed share card is blank
// (see mem:bugs/gallery-thumbnail-stale). We fill only the missing tags here (no og:title /
// twitter:title — Wix owns those; duplicating them fights its injection). The image must be an
// ABSOLUTE URL for crawlers; SITE_URL is this deployment's stable public origin — flipped to
// plux.today 2026-08-19: Wix already made www.plux.today the primary (the old wix-site-host
// URL 301s to it site-wide, measured live), so the old origin is no longer addressable anyway.
// NOTE: OG tags do NOT feed the internal gallery card —
// that is a server SCREENSHOT (site-snapshotter); the boot poster in index.astro covers that.
const SITE_URL = "https://www.plux.today";
const description =
  "Stand anywhere on a living 3D globe — real buildings and terrain, lit by the real sun, moon " +
  "and stars. Scrub time, frame the sky, and find the day your shot lines up. Photos can join " +
  "the globe too, placed by their own metadata.";
const ogImage = `${SITE_URL}/social-cover.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // #15 (batch #4 S3): iOS-DIRECTED tile cache — same snippet as MobileLayout (an iPhone
      // can open the desktop shell via /?d=1). Desktop browsers never register: their HTTP
      // cache HOLDS (measured, scripts/measure-tile-cache.mjs). Dev excluded — a stale SW
      // would mask fresh code (public/sw.js is the worker).
      try {
        var ftwIos =
          /iPhone|iPod|iPad/.test(navigator.userAgent) ||
          (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
        var ftwDev = location.hostname === "localhost" || location.hostname === "127.0.0.1";
        if (ftwIos && !ftwDev && "serviceWorker" in navigator) {
          navigator.serviceWorker.register("/sw.js");
        }
      } catch (e) {
        /* SW is a mitigation, never load-bearing */
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Type per the Claude Design system (board 02): Space Grotesk UI + IBM Plex Mono readouts. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Social / link-preview meta — fills the image + description Wix's SEO layer leaves empty. */}
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="A photograph placed on the stylized 3D globe of Plux" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
