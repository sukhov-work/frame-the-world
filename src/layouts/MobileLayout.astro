---
// MobileLayout — the /m planning shell's layout (MOBILE_PLAN M0). Layout.astro is FROZEN
// (desktop); this mirrors its essentials (tokens/global CSS, fonts, favicon, meta discipline —
// Wix's SEO layer owns og:title/twitter:card, never duplicate those) and owns the phone deltas:
// `viewport-fit=cover` for safe-area insets, with 100dvh + canvas touch discipline in
// styles/mobile/mobile.css.
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/mobile/mobile.css";

interface Props {
  title?: string;
}
const { title = "Sidera" } = Astro.props;

const description =
  "Plan photos and astro events on a living 3D globe — sun, moon and stars over real city " +
  "skylines, from your phone.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* U1 pinch hardening (owner point 5): the browser must never zoom the /m page — pinch
        belongs to the globe (zoom) and the FPV (FOV). Android honours the meta; iOS ≥10
        ignores user-scalable, so the gesturestart guard below + the touch-action discipline
        in mobile.css/chrome.css carry Safari. Desktop + /guide keep browser zoom (a11y). */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <script is:inline>
      // iOS Safari pinch/double-tap page zoom (proprietary gesture events — pointer events,
      // which the globe uses, are unaffected). Passive:false is required to preventDefault.
      document.addEventListener("gesturestart", (e) => e.preventDefault(), { passive: false });
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Type per the Claude Design system (board 02): Space Grotesk UI + IBM Plex Mono readouts. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <!-- body.m — the phone-shell scope hook: mobile CSS that must OUTRANK a reused desktop
       panel's own stylesheet (e.g. the M2 mini-map reposition) keys on it, so the win is
       specificity, not bundle order (island chunk CSS order is not guaranteed). -->
  <body class="m">
    <slot />
  </body>
</html>
