---
// MobileLayout — the /m planning shell's layout (MOBILE_PLAN M0). Layout.astro is FROZEN
// (desktop); this mirrors its essentials (tokens/global CSS, fonts, favicon, meta discipline —
// Wix's SEO layer owns og:title/twitter:card, never duplicate those) and owns the phone deltas:
// `viewport-fit=cover` for safe-area insets, with 100dvh + canvas touch discipline in
// styles/mobile/mobile.css.
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/mobile/mobile.css";

interface Props {
  title?: string;
}
const { title = "Frame the World" } = Astro.props;

const description =
  "Plan photos and astro events on a living 3D globe — sun, moon and stars over real city " +
  "skylines, from your phone.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Type per the Claude Design system (board 02): Space Grotesk UI + IBM Plex Mono readouts. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <!-- body.m — the phone-shell scope hook: mobile CSS that must OUTRANK a reused desktop
       panel's own stylesheet (e.g. the M2 mini-map reposition) keys on it, so the win is
       specificity, not bundle order (island chunk CSS order is not guaranteed). -->
  <body class="m">
    <slot />
  </body>
</html>
