---
import Layout from "../layouts/Layout.astro";
import GlobeCanvas from "../components/globe/GlobeCanvas";
import UploadFlow from "../components/panels/UploadFlow";
import TimeReadout from "../components/panels/TimeReadout";
import CameraTiltPanel from "../components/panels/CameraTiltPanel";
import TimeScrubber from "../components/panels/TimeScrubber";
import MemberBadge from "../components/panels/MemberBadge";
import MyPins from "../components/panels/MyPins";
import Marketplace from "../components/panels/Marketplace";
import Guide from "../components/panels/Guide";
import MyLocation from "../components/panels/MyLocation";
import LocationFinder from "../components/panels/LocationFinder";
import PinHoverCard from "../components/panels/PinHoverCard";
import ExploreMode from "../components/panels/ExploreMode";
import Welcome from "../components/panels/Welcome";
import FpvHud from "../components/panels/FpvHud";
import PlanPanel from "../components/panels/PlanPanel";
import FindPanel from "../components/panels/FindPanel";
import BestSpotPanel from "../components/panels/BestSpotPanel";
import PlanFindToggle from "../components/panels/PlanFindToggle";
import TargetPanel from "../components/panels/TargetPanel";
import MiniMap from "../components/panels/MiniMap";
import MapWindow from "../components/panels/MapWindow";
import SkyContextMenu from "../components/panels/SkyContextMenu";
import BuildingEditChip from "../components/panels/BuildingEditChip";
import ModelEditChip from "../components/panels/ModelEditChip";
import DebugPanel from "../components/panels/DebugPanel";
// Hover tips (tips batch 2026-07-11) — imported here so the Astro-rendered nav links get
// the same glass tip pills the React panels use.
import "../styles/tips.css";
// Boot poster (server-rendered splash) styles — see the #boot-poster block below.
import "../styles/boot-poster.css";
---

<Layout title="Plux">
  <!-- Boot poster — the ONLY server-rendered visual. Everything else on this page is a
       client:only island (C4), so without this the SSR HTML is a black void until the globe
       hydrates — which is exactly what the Wix gallery's site-snapshotter captured (it froze on
       the pre-deploy starter page; see mem:bugs/gallery-thumbnail-stale). This static splash
       paints instantly, is what a screenshot/OG crawler grabs, and hands off to the client
       <Welcome> landing (same eyebrow/title, same 7.5vw anchor → no text jump). The inline
       script below removes it on first interaction / a globe:ready event / a short safety timer;
       a JS-less or WebGL-less crawler simply keeps it. aria-hidden: <Welcome> carries the real,
       hydrated copy for assistive tech. -->
  <script is:inline>
    // Owner 2026-08-15c: a RELIABLY-detected phone boots straight into the /m shell.
    // Client-side replace ONLY — never a server UA redirect (CDN `Vary` is unverifiable; the
    // M0 ruling stands). Conservative AND of three signals (mobile UA · coarse pointer +
    // no hover · multitouch) keeps tablets and touch-laptops on desktop. Any query string
    // skips the redirect (checkout toasts, flows); `/?d=1` (the /m DESKTOP chip) persists a
    // desktop preference. The pose/FPV hash rides along — /m understands #p=/#f=.
    (function () {
      try {
        if (location.search) {
          if (/[?&]d=/.test(location.search)) localStorage.setItem("ftw:prefer-desktop", "1");
          return;
        }
        if (localStorage.getItem("ftw:prefer-desktop")) return;
        var uaMobile = /Android.+Mobile|iPhone|iPod/.test(navigator.userAgent || "");
        var coarse =
          matchMedia("(pointer: coarse)").matches && matchMedia("(hover: none)").matches;
        if (uaMobile && coarse && (navigator.maxTouchPoints || 0) > 1)
          location.replace("/m" + location.hash);
      } catch (e) {
        /* storage/matchMedia blocked — stay on desktop */
      }
    })();
  </script>
  <div id="boot-poster" class="bp" aria-hidden="true">
    <img class="bp-bg" src="/social-cover.jpg" alt="" decoding="async" fetchpriority="high" />
    <div class="bp-scrim"></div>
    <div class="bp-copy">
      <span class="bp-eyebrow">EVERY FRAME HAS ITS MOMENT</span>
      <div class="bp-title">Plan the shot where the&nbsp;world will&nbsp;take&nbsp;it.</div>
      <p class="bp-sub">
        Stand anywhere on a living globe — real streets, real skyline, the real sun, moon and
        stars. Scrub time, frame the sky, and find the day everything lines up.
      </p>
    </div>
    <span class="bp-loading">
      <span class="bp-dots"><i class="bp-dot"></i><i class="bp-dot"></i><i class="bp-dot"></i></span>
      BUILDING THE GLOBE
    </span>
  </div>
  <script is:inline>
    (function () {
      var el = document.getElementById("boot-poster");
      if (!el) return;
      // A shared/reloaded `#p=` pose (or `#f=` FPV view) boots straight into that view and
      // skips the Welcome landing — skip the splash too, matching Welcome.tsx.
      try {
        if (/^#(p|f)=/.test(location.hash)) {
          el.parentNode && el.parentNode.removeChild(el);
          return;
        }
      } catch (e) {}

      var reduce = false;
      try {
        reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      } catch (e) {}
      var MIN_MS = 350; // guard against a flash if a trigger fires instantly
      var MAX_MS = reduce ? 1200 : 3800; // safety reveal for real users; a headless snapshotter
      // that never fires globe:ready and never gets a pointer keeps the poster past this only if
      // it also runs no JS — a JS-running capture after MAX_MS sees the (equally-fine) live app.
      var startMs = ts();
      var done = false;
      var maxTimer;
      var interact = ["pointerdown", "keydown", "wheel", "touchstart"];

      function ts() {
        return window.performance && performance.now ? performance.now() : Date.now();
      }
      function remove() {
        if (el && el.parentNode) el.parentNode.removeChild(el);
      }
      function dismiss() {
        if (done) return;
        done = true;
        interact.forEach(function (t) {
          window.removeEventListener(t, onTrigger, true);
        });
        window.removeEventListener("globe:ready", onTrigger);
        if (maxTimer) clearTimeout(maxTimer);
        el.classList.add("is-hidden");
        el.addEventListener("transitionend", remove, { once: true });
        setTimeout(remove, (reduce ? 200 : 700) + 400); // hard fallback if transitionend is missed
      }
      function arm() {
        var waited = ts() - startMs;
        if (waited >= MIN_MS) dismiss();
        else setTimeout(dismiss, MIN_MS - waited);
      }
      function onTrigger() {
        arm();
      }

      interact.forEach(function (t) {
        window.addEventListener(t, onTrigger, { capture: true, passive: true });
      });
      window.addEventListener("globe:ready", onTrigger); // future hook — harmless if never fired
      maxTimer = setTimeout(arm, MAX_MS);
    })();
  </script>

  <!-- client:only="react" — the WebGL globe is NEVER server-rendered (constraint C4) -->
  <GlobeCanvas client:only="react" />

  <!-- Upload flow overlay (design board 05) — opened by any [data-open-upload] element -->
  <UploadFlow client:only="react" />

  <!-- Scene clock — the exact instant the ephemeris lights the globe with (pre-Phase-4) -->
  <TimeReadout client:only="react" />

  <!-- Manual camera declination (0° nadir … 88° horizon) — glides the globe camera -->
  <CameraTiltPanel client:only="react" />

  <!-- Scene-time scrubber (Phase 4) — drag to relight the globe; NOW resumes the wall clock -->
  <TimeScrubber client:only="react" />

  <!-- Location finder (Phase 5.5 S1) — free geocoding (Photon / Nominatim) → cinematic fly-to -->
  <LocationFinder client:only="react" />

  <!-- Hover details card over a public pin (Phase 5.5 S4) -->
  <PinHoverCard client:only="react" />

  <!-- Explore ambient pin journey (Phase 5.5 S4) — nav toggle + status chip -->
  <ExploreMode client:only="react" />

  <!-- FPV HUD (Phase 5.5 S6) — left-side bearings/focal card + off-frame sun/moon edge chips;
       renders only while an FPV mode is active. Top-level island: position:fixed must never
       live inside a backdrop-filtered card (the S2 containing-block trap). -->
  <FpvHud client:only="react" />

  <!-- Light planner (Pass 3 WS4 + Dnipro Slice 5) — jump-to-time chips + the real-skyline
       sun/moon verdict for the placed photo / FPV eye. Top-level island (same trap). -->
  <PlanPanel client:only="react" />

  <!-- FIND panel (v2, owner rework 2026-08-14) — the dedicated frame finder: "at this hour, on
       which coming days does the sun/moon/MW core stand inside THIS frame?" Standings project
       into the frame as colour-matched ghost rings (scene/findGhosts). Top-level island. -->
  <FindPanel client:only="react" />

  <!-- BEST SPOT panel (S5, SPEC_V2 §6.9) — the third face of the shared planning window: where to
       stand for this sunrise / sunset / moonrise / moonset. Gated by store/bestSpot.open, which
       only the topnav PlanFindToggle sets (mutually exclusive with PLAN and FIND). Top-level
       island — position:fixed must never sit inside a backdrop-filtered card (the S2 trap). -->
  <BestSpotPanel client:only="react" />

  <!-- Sky-target tracer (ASTRO ENGINE phase A — generalises the 10P comet panel): live position
       of the tracked target from the current anchor, a per-kind object card, and the next
       dark-sky windows. 10P stays the default guest. Top-level island. -->
  <TargetPanel client:only="react" />

  <!-- FPV mini-map (owner 2026-07-14) — a small square 2D vector patch centred on the walked
       viewer; renders only while FPV is active. Top-level island (same trap). -->
  <MiniMap client:only="react" />

  <!-- U3 fullscreen map (owner point 2) — mini-map tap opens it; photo tiles + view-from-here.
       Top-level island (same trap). -->
  <MapWindow client:only="react" />

  <!-- Sky context menu (QoL-2 ask 7) — right-click the sun / moon / tracked target: track,
       aim, ghosts, rise/set jumps. Fed by the orchestrator's hit test. Top-level island. -->
  <SkyContextMenu client:only="react" />

  <!-- U8 building height edit (owner 2026-08-18) — Δ + RESET chip while a building is armed
       (dbl-click in FPV). Top-level island (same trap); the same island mounts on /m. -->
  <BuildingEditChip client:only="react" />
  <ModelEditChip client:only="react" />

  <!-- DEBUG HUD (owner 2026-09-01) — the DBG chip's floating metrics window. Desktop-only,
       off by default; renders null until the chip flips camera.debugHud. NOT mounted on /m. -->
  <DebugPanel client:only="react" />

  <!-- Welcome landing (owner mockup 2026-07-11): journey backdrop, chrome hidden, any globe
       click / the two CTAs dismiss into the full UI -->
  <Welcome client:only="react" />

  <header class="topnav">
    <!-- Logo → clean boot (owner 2026-07-17). A plain href="/" from "/#p=…" is a SAME-DOCUMENT
         navigation (hash clears, no reload) — the app would keep its camera. The inline script
         below clears the URL state and forces a real reload so the boot path (splash → welcome
         → default LEO) runs from scratch. -->
    <div class="topnav-left">
      <a
        class="logo tip"
        id="logo-home"
        href="/"
        data-tip="FRESH START — THE CLEAN GLOBE."
        data-tip-pos="down"><img class="logo-mark" src="/logo/plux-mark.png" alt="" width="96" height="96" />Plux</a>
      <!-- owner 2026-08-15: the PLAN/FIND pills became ONE segmented toggle beside the
           wordmark — the shared window opens in the left column (PlanPanel/FindPanel). -->
      <PlanFindToggle client:only="react" />
    </div>
    <nav>
      <!-- Explore = the ambient pin journey (Phase 5.5 S4; ExploreMode binds data-explore) -->
      <a href="#explore" data-explore class="tip" data-tip="AMBIENT TOUR OF PUBLIC PINS." data-tip-pos="down">Explore</a>
      <!-- MOBILE_PLAN M0 link, moved BEFORE Upload (owner 2026-08-15c — planning outranks upload) -->
      <a href="/m" class="tip" data-tip="PLANNING SHELL FOR YOUR PHONE." data-tip-pos="down">Mobile</a>
      <!-- SURF-12 (2026-08-22g): /guide was linked from NOWHERE but the guide panel itself —
           the standalone page was unreachable and unindexable. The panel is still the primary
           in-app surface (the Guide island below); this is the document, in its own tab. -->
      <a
        href="/guide"
        target="_blank"
        rel="noopener"
        class="tip"
        data-tip="THE GUIDE AS A PLAIN, PRINTABLE PAGE."
        data-tip-pos="down">Docs</a
      >
      <a href="#upload" class="nav-upload tip" data-open-upload data-tip="ADD A PHOTO TO THE GLOBE." data-tip-pos="down">Upload</a>
      <!-- Phase 6.9: buyer-facing marketplace browse panel (owner ruling — its own nav button).
           Also hosts the ?purchased=1 post-checkout toast. Panel body + fetch are open-gated. -->
      <Marketplace client:only="react" />
      <!-- Phase 5.1: rudimentary owner pin list (members only; gallery phase replaces it) -->
      <MyPins client:only="react" />
      <!-- GUIDE — the in-app user guide (guide track G1, 2026-08-15; absorbed the FAQ).
           Body is open-gated; content = src/lib/guide/guideContent.ts (both shells). -->
      <Guide client:only="react" />
      <!-- QoL-1 (owner 2026-08-14): geolocation → temp-pin FPV at the visitor's real spot (C6:
           client-side only). The /m twin is SceneActions' 🧭 chip. -->
      <MyLocation client:only="react" />
      <!-- Phase 5: managed Wix login (@wix/astro auth routes) + member badge -->
      <MemberBadge client:only="react" />
    </nav>
  </header>
  <script is:inline>
    document.getElementById("logo-home")?.addEventListener("click", function (e) {
      e.preventDefault();
      history.replaceState(null, "", "/");
      location.reload();
    });
  </script>
  <!-- Batch #5 item 6: the /m links carry the CURRENT pose at click time (the bare href was
       dropping the hash — /m booted at the 1100 km default). Orbit tilt is forced to 0 so the
       phone lands on its 2D map at the exact coords/altitude; module script so the shared
       urlPose grammar is imported, not duplicated. Covers the topnav link AND the coarse-
       pointer banner (both are static anchors). -->
  <script>
    import { mobileShellHash } from "../lib/geo/urlPose";
    for (const a of document.querySelectorAll('a[href="/m"]')) {
      a.addEventListener("click", (e) => {
        const h = mobileShellHash(location.hash);
        if (!h) return; // no pose mirrored yet — the plain /m default boot is correct
        e.preventDefault();
        location.href = "/m" + h;
      });
    }
  </script>

  <!-- Attribution: Esri World Imagery (draped ground) + CARTO dark basemap (S7a drape) +
       Cesium ion (World Terrain + OSM Buildings, D13 manual attribution) + OpenStreetMap
       (building/basemap data) + OpenMapTiles/OpenFreeMap (S7b vector street names) + NASA
       Black Marble night lights (S5 §Item 8) + Natural Earth (S7b labels, public domain) +
       NASA/GSFC SVS Deep Star Maps 2020 Milky Way (svs.gsfc.nasa.gov/4851, Gaia DR2:
       ESA/Gaia/DPAC — credit requested per NASA media guidelines, 2026-07-15) + Copernicus
       GLO-30 (the self-baked Dnipro terrain patch, 2026-08-18 — licence requires the "produced
       using Copernicus WorldDEM-30 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH
       2014-2018 provided under COPERNICUS by the European Union and ESA" notice for adapted
       products; the full string also ships in the patch's layer.json attribution field). -->
  <!-- The wrapper exists for the map-window state (owner micro-slice 2026-08-22 item 3): while
       body.mw-open this line is PROMOTED to the one thin full-bleed bar on the screen's bottom
       edge, under the time scrubber. It carries a strict superset of the map window's sources,
       so desktop shows THIS line and MapWindow's own /m bar stays /m-only (map-window.css).
       The bar takes no pointer input — only the anchor does — so it can never steal a drag at
       the screen edge. Closed, the wrapper is an empty 0-height block and changes nothing. -->
  <div class="map-creditbar">
    <a
      class="map-credit"
      href="https://www.esri.com/"
      target="_blank"
      rel="noopener noreferrer">© Esri · Maxar · Earthstar Geographics · © CARTO · Cesium ion · © OpenStreetMap contributors · © OpenMapTiles · produced using Copernicus WorldDEM-30 © DLR/Airbus DS (EU/ESA) · NASA Earth Observatory (Suomi NPP VIIRS) · NASA/GSFC SVS · ESA/Gaia/DPAC · Natural Earth</a>
  </div>

  <!-- MOBILE_PLAN M0 (owner-ratified 2026-08-11): coarse-pointer visitors get a dismissible
       offer of /m. Client-side ONLY — never a UA redirect (CDN `Vary` is unverifiable; the
       sharded-edge-cache precedent). Dismissal persists in localStorage. -->
  <div id="m-banner" class="m-banner" hidden>
    <span>On a phone? The planning shell fits your thumb.</span>
    <a href="/m">OPEN&nbsp;/M</a>
    <button type="button" id="m-banner-dismiss" aria-label="Dismiss">×</button>
  </div>
  <script is:inline>
    (function () {
      var KEY = "ftw:m-banner-dismissed";
      var el = document.getElementById("m-banner");
      if (!el || !window.matchMedia("(pointer: coarse)").matches) return;
      try {
        if (localStorage.getItem(KEY)) return;
      } catch (e) {
        /* storage blocked → show once per load */
      }
      el.hidden = false;
      document.getElementById("m-banner-dismiss").addEventListener("click", function () {
        el.hidden = true;
        try {
          localStorage.setItem(KEY, "1");
        } catch (e) {
          /* non-fatal */
        }
      });
    })();
  </script>
</Layout>

<style>
  .topnav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.6rem;
  }
  /* Left cluster: wordmark + the PLAN/FIND toggle island (owner 2026-08-15). */
  .topnav-left {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  /* Beats the generic `.topnav a` (0,1,1) — the logo anchor keeps its identity-mark look;
     hover accents like the rest of the nav to signal the clean-boot click. */
  .topnav a.logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }
  /* The star mark (brand launch 2026-08-19) rides beside the name at text height. */
  .topnav a.logo .logo-mark {
    width: 18px;
    height: 18px;
  }
  .topnav a.logo:hover {
    color: var(--color-accent);
  }
  .topnav nav {
    display: flex;
    gap: 1.4rem;
  }
  .topnav a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }
  .topnav a:hover {
    color: var(--color-accent);
  }
  /* Upload CTA (Phase 5.5 S3, item 12): the one accent-outlined chip in the nav, with a
     single slow glow ease-in on first load — no pulsing loops (instrument restraint). */
  .topnav a.nav-upload {
    color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    margin: -0.3rem 0;
    animation: nav-upload-hello 2.6s ease-out 0.9s 1 backwards;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .topnav a.nav-upload:hover {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
  @keyframes nav-upload-hello {
    from {
      box-shadow: 0 0 0 color-mix(in srgb, var(--color-accent) 0%, transparent);
    }
    40% {
      box-shadow: 0 0 16px color-mix(in srgb, var(--color-accent) 38%, transparent);
    }
    to {
      box-shadow: 0 0 0 color-mix(in srgb, var(--color-accent) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .topnav a.nav-upload {
      animation: none;
    }
  }
  .map-credit {
    position: fixed;
    right: 0.5rem;
    bottom: 0.35rem;
    z-index: 10;
    /* The wrapper below is inert (pointer-events:none) so the map-open bar can never steal a
       bottom-edge drag — the LINK re-enables itself here, in both states. */
    pointer-events: auto;
    font-size: 0.62rem;
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    transition: color 0.2s ease;
  }
  .map-credit:hover {
    color: var(--color-text-secondary);
  }
  /* Closed state: an inert, zero-height wrapper (the anchor above is position:fixed, so this
     div contributes no layout). It only becomes a box while the map window is up. */
  .map-creditbar {
    pointer-events: none;
  }
  /* Owner micro-slice 2026-08-22 item 3 — ALL map attribution as ONE very thin full-bleed line
     on the screen's bottom edge, under the time strip. The scrubber is lifted by
     --mw-credit-h (time-scrubber.css), never z-bumped over this; the /m twin is
     map-window.css .mw-creditbar (that shell has no page credit). box-sizing is content-box
     here so the safe-area inset ADDS to the line's height, matching the lift. */
  body.mw-open .map-creditbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 44; /* over the mw-open TimeScrubber rung (43) — they never overlap spatially */
    box-sizing: content-box;
    height: var(--mw-credit-h, 0.85rem);
    padding-bottom: env(safe-area-inset-bottom);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    overflow: hidden;
  }
  body.mw-open .map-credit {
    position: static; /* pointer-events:auto rides the base rule — the ONLY hit target here */
    /* Contractual: the FULL source list stays legible and unclipped — the type scales with the
       viewport rather than truncating (thin is fine, truncated is not). */
    font-size: clamp(0.4rem, 0.72vw, 0.55rem);
    line-height: 1;
    white-space: nowrap;
    background: none;
    border-radius: 0;
    padding: 0 0.5rem;
  }
  /* …and below ≈900 px the clamp FLOOR (6.4 px) stops the shrink while this 265-character list
     keeps its width, so `nowrap` + the bar's `overflow:hidden` would clip BOTH ends — "© Esri"
     included (audit #3 A1-3, against the rule stated three lines up and the T17 ToS posture).
     Wrap instead and grow the bar; --mw-credit-h is what time-scrubber.css lifts the rail by,
     so redefining it here keeps the scrubber clear with no second rule. */
  @media (max-width: 60rem) {
    body.mw-open {
      --mw-credit-h: 1.8rem;
    }
    body.mw-open .map-creditbar {
      height: auto;
      min-height: var(--mw-credit-h);
      align-items: center;
    }
    body.mw-open .map-credit {
      white-space: normal;
      text-align: center;
      line-height: 1.25;
      padding: 0.15rem 0.5rem;
    }
  }
  /* Mobile offer banner (MOBILE_PLAN M0) — coarse-pointer only, dismissible. No fixed
     descendants inside (the backdrop-filter containing-block trap). TRAP: an author
     `display: flex` BEATS the `hidden` attribute's UA display:none — the [hidden] rule below
     is load-bearing, not decoration. */
  .m-banner[hidden] {
    display: none;
  }
  .m-banner {
    position: fixed;
    left: 50%;
    bottom: calc(3.4rem + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 11;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    white-space: nowrap;
  }
  .m-banner a {
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
  }
  .m-banner button {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.2rem;
  }
</style>
