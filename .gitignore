test/fixtures/**/*.arw
test/fixtures/**/*.dng
test/fixtures/**/*.cr3
test/fixtures/**/*.nef
test/fixtures/**/*.raf
test/fixtures/**/*.heic

# --- WASM build artifacts (committed copies live under public/wasm/) ---
# public/wasm/*.wasm is intentionally tracked; ignore any scratch build dirs:
/wasm-build/

# --- Playwright MCP scratch (screenshots / console / snapshot logs) ---
.playwright-mcp/

# --- Browser-verification screenshots (every session writes here — NEVER the repo root) ---
/verify-shots/

# --- Dnipro 3D enrichment: reproducible hand-baked Slice-0 sample (regen offline, no network):
#     `node scripts/build-sample-dnipro-tiles.mjs` — the generator is the source of truth. ---
/public/enriched-sample/

# --- Dnipro 3D enrichment: the REAL bake outputs + Overpass cache (regen: `npm run bake --
#     --city dnipro` / `node scripts/bake/bake-osm2world.mjs --city dnipro-o2w`). Baked tiles are
#     derived artifacts served from R2 in prod; they live OUTSIDE public/ (bakes/) so a build
#     bundle never ships them — dev serves them at /enriched/* via the astro.config middleware. ---
/bakes/
/public/enriched/
/scripts/bake/.cache/

# --- OSM2World "Slice 1.5" spike scratch (478 MB jar + .zip/.osm/.glb binaries — regen offline). ---
/scripts/bake/spike-osm2world/

