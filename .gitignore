# --- Claude Code local session state ---
/.claude/.env
/.claude/claude-docs/NEXT_SESSION_PROMPT.md
# Session-end auto-ship markers (session-end-ship.sh): the one-line commit title Claude leaves,
# the standing-blocking-questions marker that VETOES the auto-ship while it exists, and the
# anomaly report the hook leaves for the NEXT session (reseat events, timeouts, stale ship PRs).
/.claude/.ship-title
/.claude/BLOCKING_QUESTIONS.md
/.claude/SHIP_ATTENTION.md

# --- Node / Astro / Wix (populated after Phase 1 scaffold) ---
node_modules/
dist/
.astro/
.wix/
.env
.env.local
.env.*.local
*.tsbuildinfo

# --- Large binary test fixtures (RAW/HEIC samples) ---
# Keep the repo light; store sample RAWs outside git or via LFS if needed.
test/fixtures/**/*.arw
test/fixtures/**/*.dng
test/fixtures/**/*.cr3
test/fixtures/**/*.nef
test/fixtures/**/*.raf
test/fixtures/**/*.heic

# --- WASM build artifacts (committed copies live under public/wasm/) ---
# public/wasm/*.wasm is intentionally tracked; ignore any scratch build dirs:
/wasm-build/

# --- Playwright MCP scratch (screenshots / console / snapshot logs) ---
.playwright-mcp/

# --- Browser-verification screenshots (every session writes here — NEVER the repo root) ---
/verify-shots/

# --- Dnipro 3D enrichment: the hand-baked Slice-0 sample now lives in bakes/enriched/sample/
#     (regen offline, no network: `node scripts/build-sample-dnipro-tiles.mjs`; moved out of
#     public/ 2026-08-13 so builds never ship it — audit B10). Covered by /bakes/ below. ---

# --- Dnipro 3D enrichment: the REAL bake outputs + Overpass cache (regen: `npm run bake --
#     --city dnipro` / `node scripts/bake/bake-osm2world.mjs --city dnipro-o2w`). Baked tiles are
#     derived artifacts served from R2 in prod; they live OUTSIDE public/ (bakes/) so a build
#     bundle never ships them — dev serves them at /enriched/* via the astro.config middleware. ---
/bakes/
/public/enriched/
/scripts/bake/.cache/

# --- OSM2World "Slice 1.5" spike scratch (478 MB jar + .zip/.osm/.glb binaries — regen offline). ---
/scripts/bake/spike-osm2world/

